NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://delivery:delivery@localhost:5432/delivery_app_backend?schema=public
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
JSON_BODY_LIMIT=1mb
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000

JWT_SECRET=development-jwt-secret-with-at-least-32-characters
JWT_EXPIRES_IN=7d
JWT_REMEMBER_ME_EXPIRES_IN=30d
OTP_EXPIRES_IN_MINUTES=5
PUBLIC_API_BASE_URL=

ADMIN_FULL_NAME=System Admin
ADMIN_COUNTRY_CODE=+91
ADMIN_MOBILE_NUMBER=9999999999
ADMIN_EMAIL=admin@delevez.com
ADMIN_PASSWORD=Admin@123456
